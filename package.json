{
  "name": "vfunc",
  "version": "1.0.0-rc.3",
  "description": "UI as plain functions. A no-build vanilla JavaScript library: keep your HTML, control only what you need.",
  "license": "Apache-2.0",
  "author": "vidkid (https://github.com/vidkid-indy)",
  "homepage": "https://github.com/vidkid-indy/vfunc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vidkid-indy/vfunc.git"
  },
  "bugs": {
    "url": "https://github.com/vidkid-indy/vfunc/issues"
  },
  "keywords": [
    "vanilla",
    "javascript",
    "ui",
    "no-build",
    "spa",
    "ai-friendly",
    "html"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"layer1/test/*.test.js\" \"build/*.test.js\"",
    "test:examples": "node --test --test-concurrency=1 \"layer1/test/e2e/*.e2e.js\"",
    "build": "node build/build.mjs",
    "build:check": "node build/build.mjs --check",
    "licenses": "node build/licenses.mjs",
    "pack:dry": "npm pack --dry-run ./build/out/npm"
  },
  "devDependencies": {
    "@babel/core": "8.0.6",
    "@babel/preset-env": "8.0.6",
    "es-check": "9.8.1",
    "esbuild": "0.28.2",
    "happy-dom": "^20.14.5",
    "playwright": "1.63.0"
  }
}

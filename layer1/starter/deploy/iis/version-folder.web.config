<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0
     Copy into dist/<version>/ as web.config: files of a release never change, so cache them for a year.
     dist/<버전>/에 web.config로 복사합니다. 릴리스 파일은 바뀌지 않으므로 1년 캐시합니다.
     VERIFY: IIS adds "immutable" only through a custom header; clientCache sets max-age. -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" cacheControlCustom="public" />
    </staticContent>
  </system.webServer>
</configuration>

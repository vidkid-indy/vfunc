<?xml version="1.0" encoding="utf-8"?>
<!-- SPDX-License-Identifier: Apache-2.0
     IIS: put this file in the uploaded dist/ folder. It makes every response "no-cache".
     IIS <location> paths have no wildcards, so each version folder gets its own
     version-folder.web.config (copy it into dist/<version>/ as web.config after a release).
     업로드 폴더(dist/)에 둡니다. 버전 폴더에는 version-folder.web.config를 web.config로 복사하세요.
     VERIFY: cacheControlMode="DisableCache" sends "Cache-Control: no-cache" on your IIS version. -->
<configuration>
  <system.webServer>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>

# Netlify: put this file in the published folder (dist/).
# /:version/* matches every first-level folder; in dist/ those are only the version folders.
# 게시 폴더(dist/)에 둡니다. dist/의 1단계 폴더는 버전 폴더뿐이므로 /:version/*가 그것에만 맞습니다.

/*
  Cache-Control: no-cache
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/:version/*
  Cache-Control: public, max-age=31536000, immutable
